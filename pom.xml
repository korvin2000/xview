            <activation><property><name>swt.flavor</name><value>cocoa.macosx.aarch64</value></property></activation>
            <properties>
                <swt.ws>cocoa</swt.ws><swt.os>macosx</swt.os><swt.arch>aarch64</swt.arch>
                <xview.platform>macos-aarch64</xview.platform><xview.libdir>macos/aarch64</xview.libdir><xview.os>macos</xview.os><xview.dist.scripts>unix</xview.dist.scripts>
                <xview.natives.sha256>ef08b057985410c423e4dff87e6aacf934ebdb52451ed528cb8f663b151185db</xview.natives.sha256>
                <swt.source.dir>src/swt-stock</swt.source.dir><swt.unpack.skip>false</swt.unpack.skip>
