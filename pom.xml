<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>net.j7</groupId>
    <artifactId>j7-tools</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <url>http://maven.apache.org</url>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>26</maven.compiler.release>
        <net.j7.commons.version>1.0.0</net.j7.commons.version>
        <net.j7.thirddep.version>1.0.0</net.j7.thirddep.version>
        <junit.version>4.8.2</junit.version>
        <slf4j.version>1.7.10</slf4j.version>
        <com.carrotsearch.version>0.8.2</com.carrotsearch.version>
        <com.jhlabs.version>2.0.235-1</com.jhlabs.version>
        <!-- WPILib classes-only OpenCV jar (natives come from LibraryLoader: opencv_java460) -->
        <opencv.version>4.6.0-5</opencv.version>
        <!-- stock SWT used for the non-Windows flavors (Java classes only; see the swt-* profiles) -->
        <swt.stock.version>3.135.0</swt.stock.version>
        <!-- build output per SWT flavor; Windows keeps the plain target/ -->
        <swt.build.dir>target</swt.build.dir>
        <!-- native bundles (docs/NATIVES.md §3): one hash-pinned zip per platform from the GitHub release natives-<rev>.
             xview.natives.skip=true builds without natives (legacy loader mode); -Dxview.natives.dir=<dir containing libs/> builds
             from a local tree (profile natives-local). Platform properties come from the swt-* profiles. -->
        <xview.natives.rev>2026.10</xview.natives.rev>
        <xview.natives.url>https://github.com/korvin2000/xview/releases/download/natives-${xview.natives.rev}/xview-natives-${xview.platform}-${xview.natives.rev}.zip</xview.natives.url>
        <xview.natives.skip>false</xview.natives.skip>
        <xview.natives.dir>${project.build.directory}/natives/${xview.natives.sha256}</xview.natives.dir>
        <xview.dist.skip>${xview.natives.skip}</xview.dist.skip>
    </properties>
    <modules>
        <module>commons-j7</module>
        <module>thirddep-j7</module>

<!--<module>filecleaner-j7</module>-->
        <module>xanderView</module>
    </modules>
    <repositories>
        <!-- declared first so every other artifact is looked up on Central before WPILib -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <!-- only for edu.wpi.first.thirdparty.frc2023.opencv:opencv-java (byte-identical to the former local install) -->
        <repository>
            <id>wpilib</id>
            <url>https://frcmaven.wpi.edu/artifactory/release/</url>
            <releases>
                <enabled>true</enabled>
                <checksumPolicy>fail</checksumPolicy>
            </releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.j7.commons</groupId>
                <artifactId>commons-j7</artifactId>
                <version>${net.j7.commons.version}</version>
                <type>jar</type>
            </dependency>
            <dependency>
                <groupId>net.j7.thirddep</groupId>
                <artifactId>thirddep-j7</artifactId>
                <version>${net.j7.thirddep.version}</version>
                <type>jar</type>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.carrotsearch</groupId>
                <artifactId>hppc</artifactId>
                <version>${com.carrotsearch.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jhlabs</groupId>
                <artifactId>filters</artifactId>
                <version>${com.jhlabs.version}</version>
            </dependency>
            <dependency>
                <groupId>edu.wpi.first.thirdparty.frc2023.opencv</groupId>
                <artifactId>opencv-java</artifactId>
                <version>${opencv.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <directory>${project.basedir}/${swt.build.dir}</directory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.12.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-wrapper-plugin</artifactId>
                    <version>3.3.4</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
                <plugin>
                    <groupId>com.googlecode.maven-download-plugin</groupId>
                    <artifactId>download-maven-plugin</artifactId>
                    <version>1.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.8.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[26,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireProperty>
                                    <property>swt.ws</property>
                                    <message>No SWT flavor matches this OS/arch. Pass -Dswt.flavor=win32.win32.x86_64|gtk.linux.x86_64|gtk.linux.aarch64|cocoa.macosx.x86_64|cocoa.macosx.aarch64 (see docs/BUILD.md).</message>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            SWT flavor (PLAN P5.1). Exactly one is active: auto-selected from the build machine's OS/arch,
            or forced with -Dswt.flavor=<ws>.<os>.<arch> (cross-build; output then goes to target-<flavor>/).
            All flavors (since P7, formerly only Linux/macOS): stock SWT ${swt.stock.version} classes unpacked into
            thirddep at build time (natives and the stock loader stripped) + the patched loader in
            thirddep-j7/src/swt-stock; natives via LibraryLoader from the platform bundle (swt-win32-4974r10.dll, ...).
            Maven ANDs the activation conditions (>= 3.2.2).
        -->
        <!-- -Dxview.natives.dir=<dir containing libs/<os>/<arch>/> (e.g. natives/target/<platform> from tools/natives/bundle.sh):
             no download, dist zip built from that tree -->
        <profile>
            <id>natives-local</id>
            <activation><property><name>xview.natives.dir</name></property></activation>
            <properties>
                <xview.natives.skip>true</xview.natives.skip>
                <xview.dist.skip>false</xview.dist.skip>
            </properties>
        </profile>
        <profile>
            <id>swt-win32-x86_64</id>
            <activation>
                <os><family>windows</family><arch>amd64</arch></os>
                <property><name>!swt.flavor</name></property>
            </activation>
            <properties>
                <swt.ws>win32</swt.ws><swt.os>win32</swt.os><swt.arch>x86_64</swt.arch>
                <xview.platform>windows-x86_64</xview.platform><xview.libdir>windows/amd64</xview.libdir><xview.os>windows</xview.os><xview.dist.scripts>windows</xview.dist.scripts>
                <xview.natives.sha256>081d1e11c7b79861d0958f8d1d018bea509d5163a9cd86b19c1e6805b179d5a4</xview.natives.sha256>
                <swt.source.dir>src/swt-stock</swt.source.dir><swt.unpack.skip>false</swt.unpack.skip>
            </properties>
        </profile>
        <profile>
            <id>swt-gtk-linux-x86_64</id>
            <activation>
                <os><name>Linux</name><arch>amd64</arch></os>
                <property><name>!swt.flavor</name></property>
            </activation>
            <properties>
                <swt.ws>gtk</swt.ws><swt.os>linux</swt.os><swt.arch>x86_64</swt.arch>
                <xview.platform>linux-x86_64</xview.platform><xview.libdir>linux/x86_64</xview.libdir><xview.os>linux</xview.os><xview.dist.scripts>unix</xview.dist.scripts>
                <xview.natives.sha256>e9e22975893ab7db9815ea5d9ad30d8e9759116114d61ff4e5a4b263adb99229</xview.natives.sha256>
                <swt.source.dir>src/swt-stock</swt.source.dir><swt.unpack.skip>false</swt.unpack.skip>
                <swt.build.dir>target-gtk.linux.x86_64</swt.build.dir>
                <!-- cross flavors never reach ~/.m2: same coordinates as the Windows flavor (build them in one reactor run) -->
                <maven.install.skip>true</maven.install.skip><maven.deploy.skip>true</maven.deploy.skip>
            </properties>
        </profile>
        <profile>
            <id>swt-gtk-linux-aarch64</id>
            <activation>
                <os><name>Linux</name><arch>aarch64</arch></os>
                <property><name>!swt.flavor</name></property>
            </activation>
            <properties>
                <swt.ws>gtk</swt.ws><swt.os>linux</swt.os><swt.arch>aarch64</swt.arch>
                <xview.platform>linux-aarch64</xview.platform><xview.libdir>linux/aarch64</xview.libdir><xview.os>linux</xview.os><xview.dist.scripts>unix</xview.dist.scripts>
                <xview.natives.sha256>95db9c2fcfce9b16efad06a45d27a7a65f69fa9b21b2e4157eda924994778dc1</xview.natives.sha256>
                <swt.source.dir>src/swt-stock</swt.source.dir><swt.unpack.skip>false</swt.unpack.skip>
                <swt.build.dir>target-gtk.linux.aarch64</swt.build.dir>
                <!-- cross flavors never reach ~/.m2: same coordinates as the Windows flavor (build them in one reactor run) -->
                <maven.install.skip>true</maven.install.skip><maven.deploy.skip>true</maven.deploy.skip>
            </properties>
        </profile>
        <profile>
            <id>swt-cocoa-macosx-x86_64</id>
            <activation>
                <os><family>mac</family><arch>x86_64</arch></os>
                <property><name>!swt.flavor</name></property>
            </activation>
            <properties>
                <swt.ws>cocoa</swt.ws><swt.os>macosx</swt.os><swt.arch>x86_64</swt.arch>
                <xview.platform>macos-x86_64</xview.platform><xview.libdir>macos/x86_64</xview.libdir><xview.os>macos</xview.os><xview.dist.scripts>unix</xview.dist.scripts>
                <xview.natives.sha256>57773c0366bcaf6614cd108ecc57b05994e87aa3020edc07ddb2bfa10083087f</xview.natives.sha256>
                <swt.source.dir>src/swt-stock</swt.source.dir><swt.unpack.skip>false</swt.unpack.skip>
                <swt.build.dir>target-cocoa.macosx.x86_64</swt.build.dir>
                <!-- cross flavors never reach ~/.m2: same coordinates as the Windows flavor (build them in one reactor run) -->
                <maven.install.skip>true</maven.install.skip><maven.deploy.skip>true</maven.deploy.skip>
            </properties>
        </profile>
        <profile>
            <id>swt-cocoa-macosx-aarch64</id>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
                <property><name>!swt.flavor</name></property>
            </activation>
            <properties>
                <swt.ws>cocoa</swt.ws><swt.os>macosx</swt.os><swt.arch>aarch64</swt.arch>
                <xview.platform>macos-aarch64</xview.platform><xview.libdir>macos/aarch64</xview.libdir><xview.os>macos</xview.os><xview.dist.scripts>unix</xview.dist.scripts>
                <xview.natives.sha256>ef08b057985410c423e4dff87e6aacf934ebdb52451ed528cb8f663b151185db</xview.natives.sha256>
                <swt.source.dir>src/swt-stock</swt.source.dir><swt.unpack.skip>false</swt.unpack.skip>
                <swt.build.dir>target-cocoa.macosx.aarch64</swt.build.dir>
                <!-- cross flavors never reach ~/.m2: same coordinates as the Windows flavor (build them in one reactor run) -->
                <maven.install.skip>true</maven.install.skip><maven.deploy.skip>true</maven.deploy.skip>
            </properties>
        </profile>
        <!-- forced flavors: -Dswt.flavor=<ws>.<os>.<arch> -->
        <profile>
            <id>swt-flavor-win32.win32.x86_64</id>
            <activation><property><name>swt.flavor</name><value>win32.win32.x86_64</value></property></activation>
            <properties>
                <swt.ws>win32</swt.ws><swt.os>win32</swt.os><swt.arch>x86_64</swt.arch>
                <xview.platform>windows-x86_64</xview.platform><xview.libdir>windows/amd64</xview.libdir><xview.os>windows</xview.os><xview.dist.scripts>windows</xview.dist.scripts>
                <xview.natives.sha256>081d1e11c7b79861d0958f8d1d018bea509d5163a9cd86b19c1e6805b179d5a4</xview.natives.sha256>
                <swt.source.dir>src/swt-stock</swt.source.dir><swt.unpack.skip>false</swt.unpack.skip>
            </properties>
        </profile>
        <profile>
            <id>swt-flavor-gtk.linux.x86_64</id>
            <activation><property><name>swt.flavor</name><value>gtk.linux.x86_64</value></property></activation>
            <properties>
                <swt.ws>gtk</swt.ws><swt.os>linux</swt.os><swt.arch>x86_64</swt.arch>
                <xview.platform>linux-x86_64</xview.platform><xview.libdir>linux/x86_64</xview.libdir><xview.os>linux</xview.os><xview.dist.scripts>unix</xview.dist.scripts>
                <xview.natives.sha256>e9e22975893ab7db9815ea5d9ad30d8e9759116114d61ff4e5a4b263adb99229</xview.natives.sha256>
                <swt.source.dir>src/swt-stock</swt.source.dir><swt.unpack.skip>false</swt.unpack.skip>
                <swt.build.dir>target-gtk.linux.x86_64</swt.build.dir>
                <!-- cross flavors never reach ~/.m2: same coordinates as the Windows flavor (build them in one reactor run) -->
                <maven.install.skip>true</maven.install.skip><maven.deploy.skip>true</maven.deploy.skip>
            </properties>
        </profile>
        <profile>
            <id>swt-flavor-gtk.linux.aarch64</id>
            <activation><property><name>swt.flavor</name><value>gtk.linux.aarch64</value></property></activation>
            <properties>
                <swt.ws>gtk</swt.ws><swt.os>linux</swt.os><swt.arch>aarch64</swt.arch>
                <xview.platform>linux-aarch64</xview.platform><xview.libdir>linux/aarch64</xview.libdir><xview.os>linux</xview.os><xview.dist.scripts>unix</xview.dist.scripts>
                <xview.natives.sha256>95db9c2fcfce9b16efad06a45d27a7a65f69fa9b21b2e4157eda924994778dc1</xview.natives.sha256>
                <swt.source.dir>src/swt-stock</swt.source.dir><swt.unpack.skip>false</swt.unpack.skip>
                <swt.build.dir>target-gtk.linux.aarch64</swt.build.dir>
                <!-- cross flavors never reach ~/.m2: same coordinates as the Windows flavor (build them in one reactor run) -->
                <maven.install.skip>true</maven.install.skip><maven.deploy.skip>true</maven.deploy.skip>
            </properties>
        </profile>
        <profile>
            <id>swt-flavor-cocoa.macosx.x86_64</id>
            <activation><property><name>swt.flavor</name><value>cocoa.macosx.x86_64</value></property></activation>
            <properties>
                <swt.ws>cocoa</swt.ws><swt.os>macosx</swt.os><swt.arch>x86_64</swt.arch>
                <xview.platform>macos-x86_64</xview.platform><xview.libdir>macos/x86_64</xview.libdir><xview.os>macos</xview.os><xview.dist.scripts>unix</xview.dist.scripts>
                <xview.natives.sha256>57773c0366bcaf6614cd108ecc57b05994e87aa3020edc07ddb2bfa10083087f</xview.natives.sha256>
                <swt.source.dir>src/swt-stock</swt.source.dir><swt.unpack.skip>false</swt.unpack.skip>
