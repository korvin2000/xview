<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.j7</groupId>
        <artifactId>j7-tools</artifactId>
        <version>1.0.0</version>
    </parent>
    <groupId>net.j7.thirddep</groupId>
    <artifactId>thirddep-j7</artifactId>
    <name>thirddep-j7</name>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <scm>
        <url>https://github.com/umjammer/vavi-image-avif/</url>
    </scm>
    <url>https://github.com/umjammer/vavi-image-avif/</url>
    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

<!--	<url>http://maven.apache.org</url>-->
    <!-- plain library jar: only the app (xanderView) shades; compiler release and plugin versions come from the parent -->
    <build>
        <plugins>
            <!-- SWT flavor sources: src/swt-win32 (vendored 4.527) or src/swt-stock (patched Library overlay); see parent swt-* profiles -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>swt-flavor-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${swt.source.dir}/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>swt-flavor-resources</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${swt.source.dir}/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- non-Windows flavors: stock SWT classes only (no natives, no stock loader, no signatures) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-stock-swt</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <skip>${swt.unpack.skip}</skip>
                            <!-- ignore the 'already unpacked' marker: an IDE build may have deleted the unpacked classes since -->
                            <overWriteReleases>true</overWriteReleases>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.eclipse.platform</groupId>
                                    <artifactId>org.eclipse.swt.${swt.ws}.${swt.os}.${swt.arch}</artifactId>
                                    <version>${swt.stock.version}</version>
                                    <type>jar</type>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <excludes>META-INF/**,**/*.so,**/*.jnilib,**/*.dylib,**/*.dll,org/eclipse/swt/internal/Library.class,org/eclipse/swt/internal/Library$*.class,about_files/**,about.html,fragment.properties,.api_description</excludes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- SWT's Library.isLoadable() checks these in the jar that contains Library.class -->
                            <SWT-OS>${swt.os}</SWT-OS>
                            <SWT-WS>${swt.ws}</SWT-WS>
                            <SWT-Arch>${swt.arch}</SWT-Arch>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.j7.commons</groupId>
            <artifactId>commons-j7</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jhlabs</groupId>
            <artifactId>filters</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- real jar; com.github.umjammer:vavi-commons is only an empty jitpack aggregator pom -->
        <dependency>
            <groupId>com.github.umjammer.vavi-commons</groupId>
            <artifactId>vavi-commons</artifactId>
            <version>1.1.14</version>
        </dependency>
        <!-- vavi-image dropped: its only used class, vavi.imageio.WrappedImageInputStream, is vendored
             (jitpack 1.0.11 artifacts are gone; newer versions pull jiu + native-lib-loader) -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.15.0</version>
        </dependency>
        <!-- compile-only: the IDE build does not run the unpack above, so the patched Library.java and the app's SWT imports
             need the stock classes on the classpath (IntelliJ). The jar itself is never shipped: Maven unpacks it into the
             classes (natives, stock Library and signatures stripped) and the app's shade excludes the artifact. -->
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.swt.${swt.ws}.${swt.os}.${swt.arch}</artifactId>
            <version>${swt.stock.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><!-- its pom points at the unresolvable org.eclipse.swt.${osgi.platform} -->
                    <groupId>org.eclipse.platform</groupId>
                    <artifactId>org.eclipse.swt</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
