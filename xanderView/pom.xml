<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>net.j7</groupId>
		<artifactId>j7-tools</artifactId>
		<version>1.0.0</version>
	</parent>
	<groupId>org.delafer.xanderView</groupId>
	<artifactId>xanderview-j7</artifactId>
	<name>xanderview-j7</name>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<!-- <url>http://maven.apache.org</url> -->
	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
		</resources>
		<plugins>
			<!-- natives of the active platform (docs/NATIVES.md §3), decided at initialize: the tracked tree natives/<os>/<arch>/ when it has
			     natives.sha256, else -Dxview.natives.dir=<dir containing libs/>, else the verified bundle download below (unpacked into
			     target/natives/<sha256>, so a new bundle never mixes with an old one). xview.natives.libs = the libs/<os>/<arch> directory used;
			     its natives.sha256 + natives.deps travel inside the jar as the loader's expected set and trust anchor (docs/NATIVES.md §4). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>natives-source</id>
						<phase>initialize</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<exportAntProperties>true</exportAntProperties>
							<target>
								<condition property="xview.natives.libs" value="${xview.natives.dir}/libs/${xview.libdir}">
									<isset property="xview.natives.dir"/>
								</condition>
								<condition property="xview.natives.libs" value="${xview.natives.tree}" else="${xview.natives.dl}/libs/${xview.libdir}">
									<available file="${xview.natives.tree}/natives.sha256"/>
								</condition>
								<condition property="xview.natives.download.skip" value="true" else="${xview.natives.skip}">
									<or><isset property="xview.natives.dir"/><available file="${xview.natives.tree}/natives.sha256"/></or>
								</condition>
								<echo level="info">natives: ${xview.natives.libs} (download skipped: ${xview.natives.download.skip})</echo>
							</target>
						</configuration>
					</execution>
					<execution>
						<id>natives-manifest</id>
						<phase>process-resources</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<target>
								<copy todir="${project.build.outputDirectory}/libs/${xview.libdir}" failonerror="false" quiet="true">
									<fileset dir="${xview.natives.libs}" includes="natives.sha256,natives.deps" erroronmissingdir="false"/>
								</copy>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.googlecode.maven-download-plugin</groupId>
				<artifactId>download-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>natives-bundle</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>wget</goal>
						</goals>
						<configuration>
							<skip>${xview.natives.download.skip}</skip>
							<url>${xview.natives.url}</url>
							<sha256>${xview.natives.sha256}</sha256>
							<checkSignature>true</checkSignature>
							<unpack>true</unpack>
							<outputDirectory>${xview.natives.dl}</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<showWarnings>false</showWarnings>
					<debug>false</debug>
					<!--<compilerArgument>-Xlint:none</compilerArgument>-->
					<compilerArgs>
						<arg>-Xlint:none</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>

							<!--<minimizeJar>true</minimizeJar> -->
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>org.delafer.xanderView.gui.MainEntryPoint</mainClass>
									<!-- vendored SWT (thirddep-j7) checks these in its containing jar -->
									<manifestEntries>
										<SWT-OS>${swt.os}</SWT-OS>
										<SWT-WS>${swt.ws}</SWT-WS>
										<SWT-Arch>${swt.arch}</SWT-Arch>
										<!-- java -jar needs no flags: Enable-Native-Access silences the JNI/FFM warnings (JDK 22+). The former
										     Add-Exports java.desktop/sun.awt.windows went with the vendored SWT 4.527 (P7: stock 3.135 uses JNI). -->
										<Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
									</manifestEntries>
								</transformer>
								<!-- merge META-INF/services (ImageIO SPIs) instead of first-wins -->
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
							<artifactSet>
								<excludes>
									<!-- the stock SWT jar is an IDE-only dependency; its classes come from thirddep-j7 (unpacked, patched Library) -->
									<exclude>org.eclipse.platform:*</exclude>
								</excludes>
							</artifactSet>
							<filters>

								<!-- Exclude of dummy.sf and dummy.dsa -->
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- per-platform distribution zip: jar + libs/<os>/<arch>/ + launcher + jrunner.json + notices (docs/NATIVES.md §3);
			     declared after shade so it packs the shaded jar; skipped unless a natives bundle is present -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>dist</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<skipAssembly>${xview.dist.skip}</skipAssembly>
							<descriptors>
								<descriptor>src/assembly/dist.xml</descriptor>
							</descriptors>
							<finalName>xanderview-${project.version}-${xview.platform}</finalName>
							<appendAssemblyId>false</appendAssemblyId>
							<attach>false</attach>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
		</dependency>
		<dependency>
			<groupId>net.j7.commons</groupId>
			<artifactId>commons-j7</artifactId>
		</dependency>
		<dependency>
			<groupId>com.carrotsearch</groupId>
			<artifactId>hppc</artifactId>
		</dependency>
		<dependency>
			<!-- runtime need of the vendored mortennobel AdvancedResizeOp (thirddep has it provided) -->
			<groupId>com.jhlabs</groupId>
			<artifactId>filters</artifactId>
		</dependency>
		<dependency>
			<groupId>net.jpountz.lz4</groupId>
			<artifactId>lz4</artifactId>
			<version>1.3.0</version>
		</dependency>
		<dependency>
			<groupId>me.xuender</groupId>
			<artifactId>unidecode</artifactId>
			<version>0.0.7</version>
		</dependency>
		<dependency>
			<groupId>net.j7.thirddep</groupId>
			<artifactId>thirddep-j7</artifactId>
		</dependency>
		<!-- IDE only (IntelliJ): the stock SWT classes for compiling and running without the Maven unpack in thirddep; optional
		     (not transitive) and excluded from the shaded jar, which gets its SWT classes from thirddep-j7 -->
		<dependency>
			<groupId>org.eclipse.platform</groupId>
			<artifactId>org.eclipse.swt.${swt.ws}.${swt.os}.${swt.arch}</artifactId>
			<version>${swt.stock.version}</version>
			<optional>true</optional>
			<exclusions>
				<exclusion>
					<groupId>org.eclipse.platform</groupId>
					<artifactId>org.eclipse.swt</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>edu.wpi.first.thirdparty.frc2023.opencv</groupId>
			<artifactId>opencv-java</artifactId>
		</dependency>
	</dependencies>
</project>
