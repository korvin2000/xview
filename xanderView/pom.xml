<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>net.j7</groupId>
		<artifactId>j7-tools</artifactId>
		<version>1.0.0</version>
	</parent>
	<groupId>org.delafer.xanderView</groupId>
	<artifactId>xanderview-j7</artifactId>
	<name>xanderview-j7</name>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<!-- <url>http://maven.apache.org</url> -->
	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<!-- the natives bundle manifest travels inside the jar: the loader's expected set and trust anchor (docs/NATIVES.md §4) -->
			<resource>
				<directory>${xview.natives.dir}/libs/${xview.libdir}</directory>
				<targetPath>libs/${xview.libdir}</targetPath>
				<includes>
					<include>natives.sha256</include>
					<include>natives.deps</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<!-- natives bundle of the active platform (docs/NATIVES.md §3): verified download, unpacked into target/natives/<sha256> (a new bundle never mixes with an old one);
			     skipped when xview.natives.skip=true or a local tree is given with -Dxview.natives.dir -->
			<plugin>
				<groupId>com.googlecode.maven-download-plugin</groupId>
				<artifactId>download-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>natives-bundle</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>wget</goal>
						</goals>
						<configuration>
							<skip>${xview.natives.skip}</skip>
							<url>${xview.natives.url}</url>
							<sha256>${xview.natives.sha256}</sha256>
							<checkSignature>true</checkSignature>
							<unpack>true</unpack>
							<outputDirectory>${xview.natives.dir}</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<showWarnings>false</showWarnings>
					<debug>false</debug>
					<!--<compilerArgument>-Xlint:none</compilerArgument>-->
					<compilerArgs>
						<arg>-Xlint:none</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>

							<!--<minimizeJar>true</minimizeJar> -->
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>org.delafer.xanderView.gui.MainEntryPoint</mainClass>
									<!-- vendored SWT (thirddep-j7) checks these in its containing jar -->
									<manifestEntries>
										<SWT-OS>${swt.os}</SWT-OS>
										<SWT-WS>${swt.ws}</SWT-WS>
										<SWT-Arch>${swt.arch}</SWT-Arch>
										<!-- java -jar needs no flags: Enable-Native-Access silences the JNI/FFM warnings (JDK 22+). The former
										     Add-Exports java.desktop/sun.awt.windows went with the vendored SWT 4.527 (P7: stock 3.135 uses JNI). -->
										<Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
									</manifestEntries>
								</transformer>
								<!-- merge META-INF/services (ImageIO SPIs) instead of first-wins -->
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
							<filters>

								<!-- Exclude of dummy.sf and dummy.dsa -->
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- per-platform distribution zip: jar + libs/<os>/<arch>/ + launcher + jrunner.json + notices (docs/NATIVES.md §3);
			     declared after shade so it packs the shaded jar; skipped unless a natives bundle is present -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>dist</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<skipAssembly>${xview.dist.skip}</skipAssembly>
							<descriptors>
								<descriptor>src/assembly/dist.xml</descriptor>
							</descriptors>
							<finalName>xanderview-${project.version}-${xview.platform}</finalName>
							<appendAssemblyId>false</appendAssemblyId>
							<attach>false</attach>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
		</dependency>
		<dependency>
			<groupId>net.j7.commons</groupId>
			<artifactId>commons-j7</artifactId>
		</dependency>
		<dependency>
			<groupId>com.carrotsearch</groupId>
			<artifactId>hppc</artifactId>
		</dependency>
		<dependency>
			<!-- runtime need of the vendored mortennobel AdvancedResizeOp (thirddep has it provided) -->
			<groupId>com.jhlabs</groupId>
			<artifactId>filters</artifactId>
		</dependency>
		<dependency>
			<groupId>net.jpountz.lz4</groupId>
			<artifactId>lz4</artifactId>
			<version>1.3.0</version>
		</dependency>
		<dependency>
			<groupId>me.xuender</groupId>
			<artifactId>unidecode</artifactId>
			<version>0.0.7</version>
		</dependency>
		<dependency>
			<groupId>net.j7.thirddep</groupId>
			<artifactId>thirddep-j7</artifactId>
		</dependency>
		<dependency>
			<groupId>edu.wpi.first.thirdparty.frc2023.opencv</groupId>
			<artifactId>opencv-java</artifactId>
		</dependency>
	</dependencies>
</project>
